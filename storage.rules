rules_version = '2';
// Deploy: Firebase Console → Build → Storage → Rules → Publish
// (or `firebase deploy --only storage` if this file is wired in firebase.json)
//
// Security model:
//   - `profile-pictures/{uid}/**` is fully scoped to the owning user.
//   - Reads require self-auth (was: any authenticated user — that allowed
//     cross-user profile-pic enumeration via known uids).
//   - Writes cap file size (2 MB) and require an image/* content type so a
//     compromised client can't upload arbitrary blobs / oversized files.
//   - Every other path is default-deny.

service firebase.storage {
  match /b/{bucket}/o {
    match /profile-pictures/{userId}/{allPaths=**} {
      // Self-only read. Cross-user profile-pic viewing (e.g. group member
      // avatars) should route through the denormalized `/user-directory`
      // `photoURL`, which points at a public image (Google / Firebase Storage
      // download URL that already carries its own token).
      allow read: if request.auth != null && request.auth.uid == userId;

      // Owner-only write, capped at 2 MB and images only.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
