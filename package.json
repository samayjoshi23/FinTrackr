{
  "name": "fintrackr",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "audit:fix": "npm audit fix",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore",
    "deploy:hosting": "npm run build && npx -y firebase-tools@latest deploy --only hosting",
    "deploy:functions": "npx -y firebase-tools@latest deploy --only functions",
    "deploy:all": "npm run build && npx -y firebase-tools@latest deploy --only firestore,functions,hosting"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@angular/cdk": "^21.2.4",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/fire": "21.0.0-rc.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "apexcharts": "^5.10.4",
    "firebase": "^12.10.0",
    "firebase-functions": "^7.3.2",
    "ngx-indexed-db": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  }
}
